import java.util.*;

public class HelloWorld {
    public static void main(String[] args){ 
       Scanner sc = new Scanner(System.in);
       int vertex = sc.nextInt();
       int[][] adj = new int[vertex][vertex];       

       for(int i = 0; i < vertex; i++){  // move row wise
        for(int j = 0; j < vertex; j++){  // move column wise
            adj[i][j] = sc.nextInt();    //taking adjacency matrix input
        }
       }
       boolean[] visited = new boolean[vertex];
        dfs(0, adj, visited, vertex);   // start DFS from node 0        
    }
    public static void dfs(int node, int[][]adj, boolean[] visited, int vertex){
        visited[node] = true;
        System.out.print(node);
        for(int i = 0; i < vertex; i++){
            if(adj[node][i] == 1 && !visited[i] ){          //there is edge from node 1->i and is not visited yed
                dfs(i,adj,visited,vertex);
            }
        }
    }
}

        
    


     



