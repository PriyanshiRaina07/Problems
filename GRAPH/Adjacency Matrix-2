public class HelloWorld {
    public static void main(String[] args){ 
       int Vertex = 5;
       int[][]adj = new int[Vertex][Vertex];

       adj[0][1] = 1;
       adj[0][2] = 1;
       adj[1][3] = 1;    //in direct here its going to one direction 
       adj[2][4] = 1;

       helper(adj,Vertex);
     
    }
    public static void helper(int[][]adj,int Vertex){
        for(int i = 0; i < Vertex; i++){
            for(int j = 0; j < Vertex; j++){
                System.out.print(adj[i][j]+" ");
            }
            System.out.println();
        }
    }
}

        
    


     



