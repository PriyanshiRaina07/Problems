import java.util.ArrayList;

public class HelloWorld {
    public static void main(String[] args){ 
        int Vertex = 5;

        ArrayList<ArrayList<Integer>> adj = new ArrayList<>();

        for (int i = 0; i < Vertex; i++) {
            adj.add(new ArrayList<>());         //Create empty list for each vertex  
        }

        addEdge(adj, 0, 1);
        addEdge(adj, 0, 2);
        addEdge(adj, 1, 3);
        addEdge(adj, 2, 4);

        printAdjList(adj, Vertex);
    }

    public static void addEdge(ArrayList<ArrayList<Integer>> adj, int u, int v) {
        adj.get(u).add(v);          //directed graph   //to make it undirected use only one direction
        adj.get(v).add(u);
    }

    public static void printAdjList(ArrayList<ArrayList<Integer>> adj, int Vertex) {
        for (int i = 0; i < Vertex; i++) {
            System.out.print(i + " -> ");
            for (int v : adj.get(i)) {
                System.out.print(v + " ");
            }
            System.out.println();
        }
    }
}

        
    


     



